# Copy to .env and fill in. .env is gitignored.

# Reddit API (https://www.reddit.com/prefs/apps -> create "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=product-monitor:0.1 (by /u/yourname)

# GitHub fine-grained PAT (https://github.com/settings/tokens?type=beta).
# Permissions: Public Repositories (read-only). Used for the github_issues source.
GITHUB_TOKEN=

# Stack Exchange API key (optional, but strongly recommended).
# Register at https://stackapps.com/apps/oauth/register — instant, no approval wait.
# Anonymous mode: 300 req/day; with a key: 10,000 req/day. Used for the stackex source.
STACKEX_KEY=

# Product Hunt bearer token (required for the producthunt source).
# Create at https://api.producthunt.com/v2/oauth/applications — register an
# app, then click 'Create Token' on the app's page. Token doesn't expire.
PRODUCTHUNT_TOKEN=

# Apple App Store: NO KEY NEEDED. The public iTunes RSS/JSON feed is used
# directly by the apple_appstore source; only stream configuration
# (app_id, countries) is required in each product's Sources page.

# YouTube Data API v3 key (required for the youtube_comments source).
# 1. Go to https://console.cloud.google.com/, create a new project.
# 2. APIs & Services -> Library -> "YouTube Data API v3" -> Enable.
# 3. Credentials -> Create Credentials -> API key.
# 4. Restrict the key: API restrictions -> YouTube Data API v3 only.
# 5. Paste the key below.
# Daily quota: 10,000 units (each search=100 units, each comment page=1 unit).
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Each LLM provider you plan to use needs its API key here. Leave others
# blank — the /connections/llms page shows configured/missing status per
# provider. Local runtimes (Ollama, Foundry Local, vLLM, LM Studio,
# TabbyAPI) don't need keys — they run against localhost.
#
# `ASSISTANT_LLM_API_KEY` is a separate global connection for
# wizard drafting, snippet candidates, prompt suggestions, and headline
# generation. Usually a copy of one of the provider keys below.

# Anthropic Claude (https://console.anthropic.com/account/keys)
ANTHROPIC_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google Gemini (https://aistudio.google.com/app/apikey — free tier available)
GOOGLE_API_KEY=

# Azure OpenAI (https://portal.azure.com — create an OpenAI resource +
# deployment; both key AND endpoint are per-resource). Endpoint format:
# https://<your-resource>.openai.azure.com/openai/deployments/<deployment>
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# OpenRouter (https://openrouter.ai/keys) — proxy for many providers
OPENROUTER_API_KEY=

# Groq (https://console.groq.com/keys) — LPU-hosted, very fast
GROQ_API_KEY=

# Together.ai (https://api.together.ai/settings/api-keys)
TOGETHER_API_KEY=

# Fireworks AI (https://fireworks.ai/api-keys)
FIREWORKS_API_KEY=

# DeepInfra (https://deepinfra.com/dash/api_keys)
DEEPINFRA_API_KEY=

# Perplexity (https://www.perplexity.ai/settings/api) — web-grounded Sonar models
PERPLEXITY_API_KEY=

# Mistral La Plateforme (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Cohere (https://dashboard.cohere.com/api-keys) — Command R / R+
COHERE_API_KEY=

# Assistant LLM (ADR-0002) — separate global connection for wizard drafting,
# snippet candidates, headlines. Copy the key from whichever provider above
# powers your assistant LLM (typically Anthropic or OpenAI).
ASSISTANT_LLM_API_KEY=