# Working / historical design notes — local only. Architecture decision
# records are published: CLAUDE.md imports their index, and contributors
# (and their agents) need them.
documents/archive/*
!documents/archive/decisions/

# IDE / editor — local-only settings
.claude/
.vscode/
.idea/

# Secrets
.env

# Data & artifacts (covers per-topic layout: data/<topic_id>/raw, *.duckdb, etc.)
# Exception: the offline demo bundle (raw posts + scripted model answers),
# which `product-monitor demo` needs on a fresh clone. Its run output stays
# ignored.
data/*
!data/demo/
data/demo/*
!data/demo/llm_replay.jsonl
!data/demo/raw/
reports/
eval/reports/

# Products you monitor are your own configuration and stay local. Only the
# bundled demo ships; the wizard writes new products here too.
products/*
!products/demo/
logs/
config/history/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# OS
Thumbs.db
.DS_Store

# Atomic-write leftovers (config/app.yaml.bak, sources.yaml.tmp, etc.)
*.bak
*.tmp

# Third-party tooling that is not part of ProductMonitor
upload.sh
