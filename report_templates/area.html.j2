{% extends "_base.html.j2" %}
{% block title %}{{ display }} — {{ week_id }}{% endblock %}
{% block heading %}{{ display }}{% endblock %}
{% block subheading %}
  Area report for {{ week_id }} · {{ rollup.item_count }} items · {{ rollup.group_count }} groups ·
  <a href="comments_{{ area }}.html">item drill-down →</a>
{% endblock %}

{% block content %}
<div class="tiles">
  <div class="tile"><div class="n">{{ rollup.item_count }}</div><div class="l">Items</div></div>
  <div class="tile"><div class="n">{{ rollup.bug_count }}</div><div class="l">Bugs</div></div>
  <div class="tile">
    <div class="n">
      {% if rollup.avg_sentiment is not none %}{{ '%.2f'|format(rollup.avg_sentiment) }}{% else %}—{% endif %}
    </div><div class="l">Avg sentiment</div>
  </div>
  <div class="tile"><div class="n">{{ rollup.group_count }}</div><div class="l">Groups</div></div>
</div>

<h2>Issue groups (ranked by size)</h2>
<table>
  <thead><tr><th>Issue</th><th>Mentions</th><th>Canonical item</th></tr></thead>
  <tbody>
  {% for g in groups %}
    <tr>
      <td>{{ g.label }}</td>
      <td>{{ g.member_count }}</td>
      <td>
        {% if g.canonical %}
          <a href="{{ g.canonical.url }}" target="_blank" rel="noopener noreferrer">
            {{ g.canonical.title or g.canonical.summary or g.canonical.item_id }}</a><br>
          {% with item=g.canonical %}{% include "_item_attribution.html.j2" %}{% endwith %}
          {# POST_V1_PLAN §4.7 — rationale + highlights when the flag is on. #}
          {% if g.canonical.rationale %}
            <div class="rationale">
              <div class="rationale-text">{{ g.canonical.rationale }}</div>
              {% if g.canonical.highlights %}
                <ul class="rationale-highlights">
                  {% for h in g.canonical.highlights %}<li>{{ h }}</li>{% endfor %}
                </ul>
              {% endif %}
            </div>
          {% elif g.canonical.summary %}
            <div class="muted" style="margin-top:0.3rem; font-size:0.85rem;">{{ g.canonical.summary }}</div>
          {% endif %}
        {% else %}<span class="muted">—</span>{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>

{% if top_vendors %}
<h2>Top vendors implicated</h2>
<ul>
  {% for v in top_vendors %}<li>{{ v.vendor }} <span class="muted">×{{ v.count }}</span></li>{% endfor %}
</ul>
{% endif %}
{% endblock %}
